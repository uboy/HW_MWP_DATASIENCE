OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_TOKEN=
OLLAMA_MODEL=qwen3.5:35b
OLLAMA_USE_ENV_PROXY=0

# Optional: separate smaller model for query classification (defaults to OLLAMA_MODEL)
CLASSIFIER_MODEL=

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

CHUNK_SIZE=1100
CHUNK_OVERLAP=220
DENSE_TOP_K=40
SPARSE_TOP_K=40
FUSED_TOP_K=30
CONTEXT_TOP_K=5
RRF_K=60
HEAD_CHUNK_BOOST_COUNT=3
MIN_RERANK_SCORE=0.02

# Confidence threshold: answers below this → "No data found in document."
MIN_CONFIDENCE=0.3

# Language: auto (detect from question) | ru | en | de | fr | …
DOCUMENT_LANGUAGE=auto

OLLAMA_TEMPERATURE=0.0
OLLAMA_NUM_PREDICT=420
OLLAMA_SEED=42
OLLAMA_TIMEOUT_SEC=180
OLLAMA_DISABLE_THINKING=1
